{
  "name": "folio",
  "private": true,
  "license": "MIT",
  "version": "0.2.0",
  "description": "Folio is a book-skinned desktop client for the opencode server.",
  "type": "module",
  "opencode": {
    "version": "2.0.32"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 47321 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 47321 --strictPort",
    "test": "vitest run",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "fetch-press": "node scripts/fetch-opencode.mjs"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.2.8",
    "@fontsource/eb-garamond": "^5.2.7",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
